{
  "$schema": "http://json.schemastore.org/template",
  "author": "Olympus",
  "classifications": [
    "Web",
    "WebAPI",
    "Multi-tenant",
    "Clean Architecture",
    "EF Core",
    "PostgreSQL",
    "SQL Server",
    "JWT",
    "RBAC"
  ],
  "identity": "Olympus.MultiTenant.CleanArchitecture.WebApi",
  "name": "Olympus Multi-Tenant Platform Solution",
  "shortName": "olympus-multi",
  "sourceName": "ProjectNamePlaceholder",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "ProjectNamePlaceholder.sln"
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "templates/**",
            ".template.config/**",
            "TASKS.md"
          ]
        },
        {
          "condition": "(database == \"sqlserver\")",
          "exclude": [
            "**/Concurrency/PostgresAdvisoryBootLock.cs",
            "**/Migrations/Postgres/**"
          ]
        },
        {
          "condition": "(database == \"postgres\")",
          "exclude": [
            "**/Concurrency/SqlServerAdvisoryBootLock.cs",
            "**/Migrations/SqlServer/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgres",
      "description": "Database provider. Both are real, working implementations -- picking one excludes the other provider's package references, DI wiring, boot-lock implementation, and EF Core migrations entirely, so the generated solution never carries dead provider code. Everything else this template was originally asked to support (--orm dapper, --auth beyond jwt, --jobs, --frontend) still has exactly one real implementation today, so isn't exposed as a choice yet -- see templates/GUIDE.md.",
      "replaces": "DB_PROVIDER_TOKEN",
      "choices": [
        {
          "choice": "postgres",
          "description": "PostgreSQL via Npgsql.EntityFrameworkCore.PostgreSQL"
        },
        {
          "choice": "sqlserver",
          "description": "SQL Server via Microsoft.EntityFrameworkCore.SqlServer"
        }
      ]
    },
    "cache": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "memory",
      "description": "Distributed cache backend. Both are real, working implementations.",
      "choices": [
        {
          "choice": "memory",
          "description": "In-memory distributed cache (single instance only)"
        },
        {
          "choice": "redis",
          "description": "Redis-backed distributed cache"
        }
      ]
    },
    "UseRedis": {
      "type": "generated",
      "generator": "switch",
      "replaces": "USE_REDIS_TOKEN",
      "parameters": {
        "evaluator": "C++",
        "datatype": "bool",
        "cases": [
          { "condition": "(cache == \"redis\")", "value": "true" },
          { "condition": "(cache != \"redis\")", "value": "false" }
        ]
      }
    },
    "messagebroker": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "inprocess",
      "description": "Integration Hub event bus backend. Both are real, working implementations of IEventBus -- rabbitmq gets you at-least-once delivery across process boundaries (see templates/GUIDE.md §8); inprocess is fine until a second module needs to react to another module's events reliably.",
      "choices": [
        {
          "choice": "inprocess",
          "description": "In-process, DI-resolved handlers, no delivery guarantees beyond the caller's own transaction"
        },
        {
          "choice": "rabbitmq",
          "description": "RabbitMQ-backed, durable topic exchange + quorum queues with dead-lettering"
        }
      ]
    },
    "UseRabbitMq": {
      "type": "generated",
      "generator": "switch",
      "replaces": "USE_RABBITMQ_TOKEN",
      "parameters": {
        "evaluator": "C++",
        "datatype": "bool",
        "cases": [
          { "condition": "(messagebroker == \"rabbitmq\")", "value": "true" },
          { "condition": "(messagebroker != \"rabbitmq\")", "value": "false" }
        ]
      }
    }
  },
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore' from the src/ directory"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
