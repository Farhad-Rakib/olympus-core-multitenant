{
  // .NET performs NO ${VAR} expansion -- values like "${DB_CONNECTION_STRING}" were taken
  // literally, so anything relying on this file alone got a literal "${...}" as its connection
  // string. These are intentionally blank: supply them as environment variables, which override
  // this file (double underscore = nesting), exactly as docker-compose.yml already does:
  //
  //   ConnectionStrings__PostgresConnection, Jwt__SecretKey,
  //   Smtp__Host, Smtp__Port, Smtp__Username, Smtp__Password, Smtp__FromAddress
  //
  // Blank rather than deleted so this file still documents what must be set, and so a missing
  // value fails loudly instead of silently inheriting appsettings.json's local dev credentials.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "EnableSeq": false
  },
  // Required outside Development -- startup fails if empty. Env var form: Cors__AllowedOrigins__0
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "PostgresConnection": ""
  },
  "Jwt": {
    "SecretKey": "",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Smtp": {
    "Host": "",
    "Port": "",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "UseSsl": true
  },
  "AppSettings": {
    "Environment": "Staging",
    "EnableSwagger": false,
    "LogLevel": "Information"
  }
}
