<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ProjectNamePlaceholder.Persistence</AssemblyName>
    <RootNamespace>ProjectNamePlaceholder.Persistence</RootNamespace>
    <!--#if (database == "postgres") -->
    <DefineConstants>$(DefineConstants);OLYMPUS_DB_POSTGRES</DefineConstants>
    <!--#endif -->
    <!--#if (database == "sqlserver") -->
    <DefineConstants>$(DefineConstants);OLYMPUS_DB_SQLSERVER</DefineConstants>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectNamePlaceholder.Application/ProjectNamePlaceholder.Application.csproj" />
    <ProjectReference Include="../ProjectNamePlaceholder.Domain/ProjectNamePlaceholder.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--#if (database == "postgres") -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <!--#endif -->
    <!--#if (database == "sqlserver") -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!--#if (database == "postgres") -->
    <Compile Remove="Migrations/SqlServer/**/*.cs" />
    <!--#endif -->
  </ItemGroup>

</Project>
