{
  "$schema": "http://json.schemastore.org/template",
  "author": "Olympus",
  "classifications": ["Web", "API", "Multi-tenant", "Clean Architecture"],
  "identity": "Olympus.Templates.Multi",
  "name": "Olympus Multi-Tenant Platform Solution",
  "shortName": "olympus-multi",
  "sourceName": "OlympusCoreMultitenant",
  "preferNameDirectory": true,
  "symbols": {
    "cache": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "memory", "description": "In-memory distributed cache (single instance only)" },
        { "choice": "redis", "description": "Redis-backed distributed cache" }
      ],
      "defaultValue": "memory",
      "description": "Distributed cache backend."
    },
    "UseRedis": {
      "type": "generated",
      "generator": "switch",
      "replaces": "USE_REDIS_TOKEN",
      "parameters": {
        "evaluator": "C++",
        "datatype": "bool",
        "cases": [
          { "condition": "(cache == \"redis\")", "value": "true" },
          { "condition": "(cache != \"redis\")", "value": "false" }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": ["**/bin/**", "**/obj/**", "**/*.user"]
        }
      ]
    }
  ]
}
